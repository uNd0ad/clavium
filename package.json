    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "nodemailer": "^9.0.1",
    "pdf-lib": "^1.17.1",
    "pkijs": "^3.4.0",
    "pvutils": "^1.1.5",
    "react": "^19.2.7",
