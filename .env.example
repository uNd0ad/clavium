# Clavium — variabile de mediu
# Copiază în `.env` (local) sau configurează în panoul de hosting (Vercel → Settings → Environment Variables).
# `.env` este în .gitignore — nu comite niciodată secrete reale.

# ─── Obligatorii ──────────────────────────────────────────────────────────────

# Conexiunea la baza de date (Postgres).
# DATABASE_URL — conexiunea folosită de aplicație. Pe serverless folosește URL-ul cu POOLING
#   (Neon `-pooler` + `pgbouncer=true`, Supabase pgbouncer) ca să nu epuizezi conexiunile.
# DIRECT_URL — conexiune DIRECTĂ (fără pooler), folosită doar de migrații (`prisma migrate`).
# Local cu Docker (docker compose up -d): postgresql://clavium:clavium@localhost:5432/clavium
DATABASE_URL="postgresql://USER:PASS@HOST-pooler/DB?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"

# Cheia de semnare a token-urilor JWT. ÎN PRODUCȚIE minim 32 de caractere și diferită
# de valoarea de dev — altfel aplicația refuză să pornească (vezi src/lib/constants.ts).
# Generează una cu: openssl rand -hex 32
JWT_SECRET="dev_secret_clavium"

# URL-ul public al aplicației, fără slash final. Folosit în emailuri (linkuri de verificare/reset),
# sitemap.xml și robots.txt. În producție: https://clavium.ro
APP_URL="http://localhost:3000"

# ─── Opționale (fără ele, serviciile rulează în „mod dev” — vezi mai jos) ──────

# SMS prin SMSO.ro (https://api-docs.smso.ro/). Fără toate cele trei, codul OTP
# se afișează doar în consola serverului (mod dev). SMS_SENDER_ID vine din GET /api/v1/senders.
SMS_API_URL="https://app.smso.ro/api/v1/"
SMS_API_KEY=""
SMS_SENDER_ID=""

# Email tranzacțional (Resend/SendGrid/SES). Fără el, mesajele se afișează în consolă (mod dev).
EMAIL_API_URL=""
EMAIL_API_KEY=""

# Plăți prin Stripe Checkout (https://dashboard.stripe.com/apikeys).
# Fără STRIPE_SECRET_KEY, plățile sunt acceptate instant, fără redirect (mod dev).
# STRIPE_WEBHOOK_SECRET — secretul endpoint-ului din Dashboard → Developers → Webhooks
#   (sau afișat de `stripe listen` în dezvoltare). Webhook: POST /api/webhooks/stripe,
#   eveniment `checkout.session.completed`. Fără el, webhook-ul răspunde 503.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Furnizor QES eIDAS (certSIGN/Namirial/DocuSign EU). Fără el, semnarea e simulată (mod dev).
QES_API_KEY=""

# ─── Stocare obiecte (fotografii + documente KYC) ───────────────────────────────
# Implicit (STORAGE_DRIVER gol) → disc local. Pe Vercel discul e EFEMER: fotografiile
# și documentele KYC se pierd la fiecare redeploy. În producție setează STORAGE_DRIVER=s3
# și un bucket S3-compatibil (recomandat Cloudflare R2 — fără taxe de egress).
#   - PUBLIC_BUCKET   → fotografiile proprietăților (citire publică prin BASE_URL/CDN)
#   - PRIVATE_BUCKET  → documentele KYC (NICIODATĂ public; bucket separat, fără acces anonim)
#   - PUBLIC_BASE_URL → baza URL publică (r2.dev, CDN sau domeniu custom); host-ul ei
#       trebuie să fie accesibil pentru next/image (se adaugă automat în remotePatterns)
#   - ENDPOINT        → pentru R2: https://<account_id>.r2.cloudflarestorage.com (AWS S3: lasă gol)
#   - REGION          → pentru R2: auto
# Cloudflare R2 (exemplu complet):
#   STORAGE_DRIVER=s3
#   STORAGE_S3_REGION=auto
#   STORAGE_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   STORAGE_S3_ACCESS_KEY_ID / SECRET = token R2 (R2 API Token cu permisiuni Object Read & Write)
#   STORAGE_S3_PUBLIC_BASE_URL = https://<bucket>.<account>.r2.dev SAU domeniul tău custom
# Notă: clientul forțează checksum-uri WHEN_REQUIRED (compatibilitate R2) — nu trebuie să schimbi nimic.
STORAGE_DRIVER=""
STORAGE_S3_REGION="auto"
STORAGE_S3_ENDPOINT=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
STORAGE_S3_PUBLIC_BUCKET=""
STORAGE_S3_PRIVATE_BUCKET=""
STORAGE_S3_PUBLIC_BASE_URL=""
# Lasă gol pentru R2/AWS (stil virtual-hosted). Setează "true" doar pentru provideri care cer
# path-style (ex. MinIO).
STORAGE_S3_FORCE_PATH_STYLE=""

# ─── Sarcini programate (Vercel Cron) ───────────────────────────────────────────
# Secret partajat: Vercel îl trimite ca `Authorization: Bearer <CRON_SECRET>` la rutele
# /api/cron/*. Fără el în producție, rutele de cron resping toate cererile (vezi src/lib/cron.ts).
# Generează: openssl rand -hex 32
CRON_SECRET=""
# Retenția imaginilor biometrice KYC (zile). După o decizie finală (VERIFIED/REJECTED), imaginile
# brute (act + selfie) se purjează din stocarea privată după acest interval; rămân doar amprentele
# + decizia. Implicit 30. Rulează în cron-ul zilnic /api/cron/cleanup.
KYC_RETENTION_DAYS="30"

# Curs EUR→RON pentru afișarea multi-valută (vânzările sunt de regulă cotate în euro). Sumele se
# stochează în RON; EUR e doar reprezentare de afișare. SURSA IMPLICITĂ e cursul oficial BNR
# (feed-ul de referință, cache-uit ~6h). Setează EUR_RON_RATE DOAR ca override manual (ex. pin la
# o valoare fixă); lasă-l gol pentru a folosi BNR. Dacă BNR e indisponibil, se cade pe 4.97.
EUR_RON_RATE=""

# ─── Observabilitate (Sentry, opțional) ─────────────────────────────────────────
# Cu SENTRY_DSN setat ȘI pachetul instalat (`npm i @sentry/nextjs`), erorile neașteptate trecute
# prin captureException (auth, plăți, webhook-uri) sunt raportate către Sentry. Fără DSN: no-op.
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"

# ─── Integrări externe (scaffold env-gated; inactive fără credențiale) ───────────
# Hărți: cheie Google Maps. Pin exact doar pentru listările exclusive; altfel zonă aproximativă.
NEXT_PUBLIC_MAPS_API_KEY=""
# Import listări din OLX/Storia/Imobiliare. „true" îl activează (atenție la ToS-ul surselor).
LISTING_IMPORT_ENABLED="false"
# e-Factura ANAF (facturare comisioane): credențiale OAuth SPV. Fără ele → doar generare XML UBL.
EFACTURA_CLIENT_ID=""
EFACTURA_CLIENT_SECRET=""
# Plăți către proprietari (Stripe Connect). „true" + conturi conectate pentru payout-uri reale.
STRIPE_CONNECT_ENABLED="false"
