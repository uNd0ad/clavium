generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer) pentru aplicație/runtime; direct pentru migrații (migrate nu merge prin pooler).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String   @id @default(uuid())
  firstName       String
  lastName        String
  email           String   @unique
  phone           String?
  passwordHash    String
  role            String   @default("CLIENT")
  emailVerified   Boolean  @default(false)
  phoneVerified   Boolean  @default(false)
  // Verificare identitate (KYC): UNVERIFIED | PENDING | VERIFIED | REJECTED.
  // Coloană de citire rapidă (sesiune/gating); detaliile stau în KycVerification.
  kycStatus       String   @default("UNVERIFIED")
  isActive        Boolean  @default(true)
  avatar          String?
  // Autentificare în doi pași (TOTP). `totpSecret` e setat și cât timp configurarea e în curs
  // (neconfirmată); `totpEnabled` devine true abia după confirmarea unui cod valid. `totpBackupCodes`
  // = JSON cu amprente sha256 ale codurilor de rezervă (consumate o singură dată).
  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  totpBackupCodes String   @default("[]")
  // Program de recomandare: cod propriu (partajabil) + cine l-a recomandat pe acest utilizator.
  referralCode    String?  @unique
  referredById    String?
  referredBy      User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals       User[]   @relation("Referrals")
  // Tip cont: PERSON (persoană fizică) sau COMPANY (persoană juridică).
  // Pentru COMPANY, firstName/lastName = reprezentantul legal.
  accountType     String   @default("PERSON")
  companyName     String?
  companyCui      String? // CUI/CIF
  companyReg      String? // nr. înregistrare ORC (J…)
  companyAddress  String?
  companyVatPayer Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  properties        Property[]       @relation("OwnedProperties")
  savedProperties   SavedProperty[]
  offersSent        Offer[]          @relation("OffersSent")
  offersReceived    Offer[]          @relation("OffersReceived")
  contractsAsOwner  Contract[]       @relation("ContractsAsOwner")
  contractsAsTenant Contract[]       @relation("ContractsAsTenant")
  payments          Payment[]
  notifications     Notification[]
  sessions          Session[]
  emailTokens       EmailToken[]
  ticketsAuthored   Ticket[]         @relation("TicketsAuthored")
  ticketMessages    TicketMessage[]  @relation("TicketMessages")
  ticketReads       TicketRead[]     @relation("TicketReads")
  signatures        Signature[]      @relation("UserSignatures")
  inquiriesSent     Inquiry[]        @relation("InquiriesSent")
  inquiriesReceived Inquiry[]        @relation("InquiriesReceived")
  inquiryMessages   InquiryMessage[] @relation("InquiryMessages")
  termsConsents     TermsConsent[]
  reviewsAuthored   Review[]         @relation("ReviewsAuthored")
  reviewsReceived   Review[]         @relation("ReviewsReceived")
  reportsFiled      Report[]         @relation("ReportsFiled")
  savedSearches     SavedSearch[]
  kyc               KycVerification?
}

// Căutare salvată de un utilizator: filtrele (JSON) + momentul ultimei alerte trimise. Un job
// periodic notifică listările noi care se potrivesc (vezi processSavedSearchAlerts).
model SavedSearch {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String?
  filters        String    @default("{}") // JSON: PropertyFilters (q, type, minRent, maxRent, rooms, minSurface)
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

// Sesizare de abuz/fraudă pentru o listare sau un utilizator. Reporter null = sistem (detecția
// automată de fraudă). Adminii rezolvă firul din coada de moderare.
model Report {
  id           String    @id @default(uuid())
  reporterId   String? // null = generat de sistem (fraud auto)
  reporter     User?     @relation("ReportsFiled", fields: [reporterId], references: [id])
  targetType   String // PROPERTY | USER
  targetId     String
  reason       String // SPAM | FRAUD | INAPPROPRIATE | FRAUD_AUTO | OTHER
  details      String?
  status       String    @default("DESCHIS") // DESCHIS | REZOLVAT | RESPINS
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status])
  @@index([targetType, targetId])
}

// Recenzie reciprocă după încheierea unui contract: o parte evaluează cealaltă (1–5 + comentariu).
// O singură recenzie per contract per autor. Stă la baza reputației afișate pe listări/profiluri.
model Review {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])
  authorId   String
  author     User     @relation("ReviewsAuthored", fields: [authorId], references: [id])
  subjectId  String
  subject    User     @relation("ReviewsReceived", fields: [subjectId], references: [id])
  rating     Int // 1..5
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([contractId, authorId])
  @@index([subjectId])
}

// Consimțământul unui utilizator la o anumită versiune a Termenilor și Condițiilor.
// Când versiunea curentă (TERMS_VERSION) e mai nouă decât ultima acceptată, i se cere re-consimțământ.
model TermsConsent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version    String
  acceptedAt DateTime @default(now())

  @@unique([userId, version])
  @@index([userId])
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  // Metadate de dispozitiv pentru managementul sesiunilor (listare / revocare / alertă dispozitiv nou).
  userAgent  String?
  ip         String?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model EmailToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  type      String // VERIFY_EMAIL | RESET_PASSWORD
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  code      String // hash sha256
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PhoneOtp {
  id         String    @id @default(uuid())
  phone      String
  code       String // hash sha256
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Property {
  id              String          @id @default(uuid())
  title           String
  description     String?
  location        String
  // Tip tranzacție: INCHIRIERE (folosește `rent`) sau VANZARE (folosește `price`).
  transactionType String          @default("INCHIRIERE")
  rent            Int             @default(0)
  price           Int             @default(0) // preț de vânzare (RON), pentru transactionType=VANZARE
  rooms           Int?
  surface         Int?
  photos          String          @default("[]") // JSON: array de URL-uri /uploads/...
  // Coordonate pentru hartă. Pin exact afișat doar pentru listările exclusive (acord de exclusivitate);
  // pentru restul se arată zona aproximativă (vezi lib/maps.ts).
  lat             Float?
  lng             Float?
  isExclusive     Boolean         @default(false)
  status          String          @default("DISPONIBILA") // DISPONIBILA | INCHIRIATA | REZERVATA | VANDUTA | INACTIVA
  ownerId         String
  owner           User            @relation("OwnedProperties", fields: [ownerId], references: [id])
  savedBy         SavedProperty[]
  offers          Offer[]
  contracts       Contract[]
  inquiries       Inquiry[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([ownerId])
  @@index([status, transactionType])
}

// Întrebare pre-contract: un utilizator interesat întreabă proprietarul despre o listare,
// înainte de orice ofertă/contract. Un singur fir per (listare, utilizator); conversația în
// InquiryMessage. Distinct de Ticket (care e legat de un contract activ).
model Inquiry {
  id         String           @id @default(uuid())
  propertyId String
  property   Property         @relation(fields: [propertyId], references: [id])
  fromUserId String
  fromUser   User             @relation("InquiriesSent", fields: [fromUserId], references: [id])
  ownerId    String
  owner      User             @relation("InquiriesReceived", fields: [ownerId], references: [id])
  status     String           @default("DESCHIS") // DESCHIS | INCHIS
  messages   InquiryMessage[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([propertyId, fromUserId])
  @@index([ownerId])
  @@index([fromUserId])
}

model InquiryMessage {
  id        String   @id @default(uuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("InquiryMessages", fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([inquiryId])
}

// Amprentă perceptuală (aHash) a unei fotografii de listare. Folosită la detecția fraudei:
// dacă o fotografie nouă se potrivește (distanță Hamming mică) cu una a altui proprietar,
// e semnal de fotografie furată / listare duplicat. Vezi src/lib/fraud.ts.
model PhotoSignature {
  id         String   @id @default(uuid())
  propertyId String
  ownerId    String
  hash       String // aHash pe 64 de biți (16 hex)
  createdAt  DateTime @default(now())

  @@index([hash])
  @@index([propertyId])
}

// Registru de audit append-only, înlănțuit prin hash (fiecare intrare include hash-ul celei
// anterioare) → orice ștergere/modificare a unei intrari rupe lanțul și e detectabilă.
// Scrierile sunt serializate cu un advisory lock Postgres (vezi src/lib/audit.ts) ca `seq` și
// `prevHash` să fie consistente. Sursă de adevăr pentru dispute (semnături, plăți, modificări).
model AuditLog {
  id         String   @id @default(uuid())
  seq        Int      @unique // poziție în lanț (1, 2, 3, …), atribuită secvențial sub lock
  actorId    String? // utilizatorul care a declanșat evenimentul (null = sistem)
  action     String // ex: CONTRACT_SIGNED | PAYMENT_SETTLED | DEPOSIT_RETURNED | SALE_CANCELLED
  entityType String // CONTRACT | PAYMENT | PROPERTY | INQUIRY | USER
  entityId   String
  metadata   String? // JSON cu detalii
  prevHash   String // hash-ul intrării anterioare (sau genesis pentru prima)
  hash       String // sha256(payload canonic + prevHash)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model SavedProperty {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
}

model Offer {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  fromUserId String
  fromUser   User     @relation("OffersSent", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("OffersReceived", fields: [toUserId], references: [id])
  amount     Int
  status     String   @default("TRIMISA") // TRIMISA | ACCEPTATA | RESPINSA
  createdAt  DateTime @default(now())

  @@index([toUserId])
  @@index([fromUserId])
  @@index([propertyId, status])
}

model Contract {
  id             String      @id @default(uuid())
  propertyId     String
  property       Property    @relation(fields: [propertyId], references: [id])
  ownerId        String
  owner          User        @relation("ContractsAsOwner", fields: [ownerId], references: [id])
  tenantId       String
  tenant         User        @relation("ContractsAsTenant", fields: [tenantId], references: [id])
  // Tip contract: INCHIRIERE (locațiune) sau VANZARE (antecontract de vânzare-cumpărare).
  type           String      @default("INCHIRIERE")
  rent           Int         @default(0)
  price          Int         @default(0) // preț de vânzare (RON), pentru type=VANZARE
  months         Int         @default(12)
  deposit        Int         @default(0) // garanție (închiriere) sau avans (vânzare)
  dueDay         Int         @default(5) // ziua scadentă a chiriei
  startDate      DateTime?
  endDate        DateTime?
  clauses        String? // clauze speciale
  signedByOwner  Boolean     @default(false)
  signedByClient Boolean     @default(false)
  qes            Boolean     @default(false)
  status         String      @default("IN_ASTEPTARE") // IN_ASTEPTARE | SEMNAT | ACTIV | INCHEIAT | ANULAT
  // Garanția (închiriere): HELD (reținută) | RETURNED (restituită integral) | PARTIAL (parțial,
  // cu rețineri pentru daune) | FORFEITED (pierdută) | NONE (fără garanție / nu se aplică).
  depositStatus  String      @default("HELD")
  // Anulare / reziliere: când și de ce a fost încheiat contractul înainte de termen.
  cancelledAt    DateTime?
  cancelReason   String?
  // Plata automată a chiriei (opt-in al chiriașului): la scadență, chiria se încasează automat
  // (off-session prin cardul salvat, când Stripe e activ; în mod dev se decontează direct).
  autopayEnabled Boolean     @default(false)
  payments       Payment[]
  tickets        Ticket[]
  signatures     Signature[]
  reviews        Review[]
  createdAt      DateTime    @default(now())

  @@index([ownerId])
  @@index([tenantId])
  @@index([propertyId, status])
}

// Semnătură electronică calificată (QES) a unei părți pe un contract.
// Pistă de audit conformă eIDAS: cine a semnat, când, cu ce referință de la furnizorul
// QES și peste ce amprentă a documentului (leagă semnătura de conținutul semnat — orice
// modificare ulterioară a termenilor ar invalida amprenta).
model Signature {
  id           String   @id @default(uuid())
  contractId   String
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  signerId     String
  signer       User     @relation("UserSignatures", fields: [signerId], references: [id])
  role         String // OWNER | CLIENT
  signerName   String
  signerEmail  String
  signatureRef String // referința semnăturii returnată de furnizorul QES
  provider     String   @default("dev") // dev | certsign | namirial | docusign
  qes          Boolean  @default(true)
  documentHash String // sha256 al documentului semnat
  signedAt     DateTime @default(now())

  // Semnătură cu certificat calificat încărcat de semnatar (cheia privată rămâne la el; el semnează
  // amprenta, noi verificăm). Câmpuri opționale: semnăturile vechi/dev nu le au.
  certificatePem   String? // certificatul X.509 al semnatarului (PEM), păstrat ca probă
  certSubject      String? // subiectul certificatului (CN/identitate)
  certIssuer       String? // emitentul (CA calificat)
  certSerial       String? // numărul de serie al certificatului
  certNotAfter     DateTime? // expirarea certificatului la momentul semnării
  signatureValue   String? // semnătura (base64) peste documentHash
  signatureAlgo    String? // algoritmul semnăturii (ex. RSASSA-PKCS1-v1_5 / SHA-256)
  validationStatus String? // rezultatul validării: QUALIFIED | VALID | dev/null pentru cele vechi

  // O singură semnătură per parte per contract (re-semnarea actualizează aceeași înregistrare).
  @@unique([contractId, signerId])
}

// Verificarea identității (KYC) a unui utilizator — dosarul de verificare la furnizorul de
// identitate (Onfido, Veriff, Sumsub…). Mod dev: decizia e simulată (verificat instant), la
// fel ca plățile fără Stripe și semnarea fără furnizor QES. Un singur dosar curent per
// utilizator (re-trimiterea actualizează aceeași înregistrare). Documentele încărcate NU se
// stochează public: păstrăm doar amprentele (sha256) + numărul lor, ca pistă de audit.
model KycVerification {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  provider        String    @default("dev") // dev | onfido | veriff | sumsub
  reference       String // referința dosarului returnată de furnizorul de identitate
  method          String    @default("face_match") // face_match (local) | id_document (furnizor)
  documentHashes  String    @default("[]") // JSON: array de amprente sha256 ale documentelor încărcate
  // JSON: array de chei de stocare ale documentelor brute (act + selfie). Se golește la purjare.
  documentKeys    String    @default("[]")
  documentCount   Int       @default(0)
  // Distanța euclidiană între fața de pe act și selfie (mod local, fără eIDAS). Mai mic = mai sigur.
  matchScore      Float?
  rejectionReason String?
  // Consimțământ explicit pentru prelucrarea datelor biometrice (față) — categorie specială GDPR.
  biometricConsentAt DateTime?
  // Momentul purjării imaginilor biometrice brute (retenție): rămân doar amprentele + decizia.
  biometricPurgedAt  DateTime?
  submittedAt     DateTime  @default(now())
  verifiedAt      DateTime?
}

model Payment {
  id         String    @id @default(uuid())
  reference  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id])
  amount     Int
  type       String // CHIRIE | COMISION | REFUND | AVANS | REST
  status     String    @default("IN_CURS") // FINALIZATA | IN_CURS | ESUATA
  dueDate    DateTime?
  paidAt     DateTime?
  // Ultima notificare de scadență/restanță trimisă (dunning) — face cron-ul idempotent.
  lastReminderAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([contractId, type, status])
  // Cron-ul de dunning scanează după tip + status + scadență.
  @@index([type, status, dueDate])
}

// Tichet de asistență deschis de chiriaș pe un contract de închiriere activ.
// Conversația dintre chiriaș și proprietar (+ admin) se desfășoară în TicketMessage.
model Ticket {
  id         String          @id @default(uuid())
  contractId String
  contract   Contract        @relation(fields: [contractId], references: [id])
  authorId   String // chiriașul care a deschis tichetul
  author     User            @relation("TicketsAuthored", fields: [authorId], references: [id])
  subject    String
  category   String          @default("ALTELE") // MENTENANTA | PLATA | CONTRACT | ALTELE
  priority   String          @default("NORMALA") // SCAZUTA | NORMALA | URGENTA
  status     String          @default("DESCHIS") // DESCHIS | IN_LUCRU | REZOLVAT | INCHIS
  messages   TicketMessage[]
  reads      TicketRead[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([contractId])
  @@index([authorId])
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("TicketMessages", fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId])
}

// Ultima dată când un utilizator a deschis un tichet — pentru indicatorul „răspuns nou".
model TicketRead {
  id       String   @id @default(uuid())
  ticketId String
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation("TicketReads", fields: [userId], references: [id], onDelete: Cascade)
  readAt   DateTime @default(now())

  @@unique([ticketId, userId])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  description String
  variant     String   @default("info") // info | warning | danger | success
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, read])
}
