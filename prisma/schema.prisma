generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer) pentru aplicație/runtime; direct pentru migrații (migrate nu merge prin pooler).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(uuid())
  firstName     String
  lastName      String
  email         String   @unique
  phone         String?
  passwordHash  String
  role          String   @default("CLIENT")
  emailVerified Boolean  @default(false)
  phoneVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  avatar        String?
  // Tip cont: PERSON (persoană fizică) sau COMPANY (persoană juridică).
  // Pentru COMPANY, firstName/lastName = reprezentantul legal.
  accountType     String   @default("PERSON")
  companyName     String?
  companyCui      String? // CUI/CIF
  companyReg      String? // nr. înregistrare ORC (J…)
  companyAddress  String?
  companyVatPayer Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  properties        Property[]      @relation("OwnedProperties")
  savedProperties   SavedProperty[]
  offersSent        Offer[]         @relation("OffersSent")
  offersReceived    Offer[]         @relation("OffersReceived")
  contractsAsOwner  Contract[]      @relation("ContractsAsOwner")
  contractsAsTenant Contract[]      @relation("ContractsAsTenant")
  payments          Payment[]
  notifications     Notification[]
  sessions          Session[]
  emailTokens       EmailToken[]
  ticketsAuthored   Ticket[]        @relation("TicketsAuthored")
  ticketMessages    TicketMessage[] @relation("TicketMessages")
  ticketReads       TicketRead[]    @relation("TicketReads")
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

model EmailToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  type      String // VERIFY_EMAIL | RESET_PASSWORD
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  code      String // hash sha256
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PhoneOtp {
  id         String    @id @default(uuid())
  phone      String
  code       String // hash sha256
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
}

model Property {
  id          String   @id @default(uuid())
  title       String
  description String?
  location    String
  // Tip tranzacție: INCHIRIERE (folosește `rent`) sau VANZARE (folosește `price`).
  transactionType String @default("INCHIRIERE")
  rent        Int      @default(0)
  price       Int      @default(0) // preț de vânzare (RON), pentru transactionType=VANZARE
  rooms       Int?
  surface     Int?
  photos      String   @default("[]") // JSON: array de URL-uri /uploads/...
  status      String   @default("DISPONIBILA") // DISPONIBILA | INCHIRIATA | REZERVATA | VANDUTA | INACTIVA
  ownerId     String
  owner       User     @relation("OwnedProperties", fields: [ownerId], references: [id])
  savedBy     SavedProperty[]
  offers      Offer[]
  contracts   Contract[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SavedProperty {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model Offer {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  fromUserId String
  fromUser   User     @relation("OffersSent", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("OffersReceived", fields: [toUserId], references: [id])
  amount     Int
  status     String   @default("TRIMISA") // TRIMISA | ACCEPTATA | RESPINSA
  createdAt  DateTime @default(now())
}

model Contract {
  id             String    @id @default(uuid())
  propertyId     String
  property       Property  @relation(fields: [propertyId], references: [id])
  ownerId        String
  owner          User      @relation("ContractsAsOwner", fields: [ownerId], references: [id])
  tenantId       String
  tenant         User      @relation("ContractsAsTenant", fields: [tenantId], references: [id])
  // Tip contract: INCHIRIERE (locațiune) sau VANZARE (antecontract de vânzare-cumpărare).
  type           String    @default("INCHIRIERE")
  rent           Int       @default(0)
  price          Int       @default(0) // preț de vânzare (RON), pentru type=VANZARE
  months         Int       @default(12)
  deposit        Int       @default(0) // garanție (închiriere) sau avans (vânzare)
  dueDay         Int       @default(5) // ziua scadentă a chiriei
  startDate      DateTime?
  endDate        DateTime?
  clauses        String? // clauze speciale
  signedByOwner  Boolean   @default(false)
  signedByClient Boolean   @default(false)
  qes            Boolean   @default(false)
  status         String    @default("IN_ASTEPTARE") // IN_ASTEPTARE | SEMNAT | ACTIV | INCHEIAT
  payments       Payment[]
  tickets        Ticket[]
  createdAt      DateTime  @default(now())
}

model Payment {
  id         String    @id @default(uuid())
  reference  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id])
  amount     Int
  type       String // CHIRIE | COMISION | REFUND | AVANS | REST
  status     String    @default("IN_CURS") // FINALIZATA | IN_CURS | ESUATA
  dueDate    DateTime?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
}

// Tichet de asistență deschis de chiriaș pe un contract de închiriere activ.
// Conversația dintre chiriaș și proprietar (+ admin) se desfășoară în TicketMessage.
model Ticket {
  id         String          @id @default(uuid())
  contractId String
  contract   Contract        @relation(fields: [contractId], references: [id])
  authorId   String // chiriașul care a deschis tichetul
  author     User            @relation("TicketsAuthored", fields: [authorId], references: [id])
  subject    String
  category   String          @default("ALTELE") // MENTENANTA | PLATA | CONTRACT | ALTELE
  priority   String          @default("NORMALA") // SCAZUTA | NORMALA | URGENTA
  status     String          @default("DESCHIS") // DESCHIS | IN_LUCRU | REZOLVAT | INCHIS
  messages   TicketMessage[]
  reads      TicketRead[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("TicketMessages", fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

// Ultima dată când un utilizator a deschis un tichet — pentru indicatorul „răspuns nou".
model TicketRead {
  id       String   @id @default(uuid())
  ticketId String
  ticket   Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation("TicketReads", fields: [userId], references: [id], onDelete: Cascade)
  readAt   DateTime @default(now())

  @@unique([ticketId, userId])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  description String
  variant     String   @default("info") // info | warning | danger | success
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}
